# Copy to `.env.local` and `site/.env.local` (keep both aligned).
# Run `pnpm run ops env:sync` to append missing alias keys from canonical values.
# Gate: `pnpm run ops launch:env`

# --- Site URL (main Next product :3000 / prod apex) ---
NEXT_PUBLIC_SITE_URL=https://oando.co.in
SITE_URL=https://oando.co.in
# Optional Search Console / Bing ownership (main site metadata only — public tokens)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Tech-docs SPA link from Admin (dev :3001 · prod Vercel host until docs.oando.co.in SSL works)
# Dev:  http://localhost:3001
# Prod: https://techdocsgenerator.vercel.app  (docs.oando.co.in is Cloudflare 525 until OPS)
NEXT_PUBLIC_TECH_DOCS_URL=http://localhost:3001

# --- Supabase public (products) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase admin (planner / auth) ---
SUPABASE_AUTH_URL=
NEXT_ADMIN_SUPABASE_URL=
NEXT_ADMIN_SUPABASE_ANON_KEY=
NEXT_ADMIN_PUBLISHABLE_KEY=
SUPABASE_ADMIN_SERVICE_ROLE_KEY=

# --- Postgres ---
PRODUCTS_DATABASE_URL=
SUPABASE_AUTH_DATABASE_URL=
PLANNER_DATABASE_URL=

# --- LLM (Studio AI + embedder) ---
OPENROUTER_API_KEY_PRIMARY=
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_BACKUP=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Lance vector store (site/.data/lancedb/catalog when unset) ---
# Repo root .env.local: site/.data/lancedb/catalog
# site/.env.local: .data/lancedb/catalog
LANCE_DB_URI=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=One&Only <ayush@oando.co.in>
STAFF_NOTIFY_EMAIL=ayush@oando.co.in
RESEND_INBOX=
ADMIN_EMAILS=

# --- Cloudflare — MAIN SITE (Next product + catalog CDN/R2) ---
# Used by: site app, asset upload/scripts, Worker ops. Not injected into tech-docs SPA.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_CATALOG_BUCKET=oando-asset-cdn
CLOUDFLARE_R2_BUCKET=oando-asset-cdn
R2_CATALOG_BUCKET=oando-asset-cdn
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_S3_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# Public asset origin (apex or CDN). Prod often https://oando.co.in
NEXT_PUBLIC_ASSET_BASE_URL=https://oando.co.in
# Zone/API token (DNS, Worker, CDN ops) — not the R2 S3 key pair.
CLOUDFLARE_API_TOKEN=

# --- Cloudflare / DNS — TECH-DOCS host (OPS-S01 / F3) ---
# No extra R2 keys for the docs SPA. After DNS exists:
#   1) CNAME docs.oando.co.in → tech-docs deploy host (proxied)
#   2) Main app prod: NEXT_PUBLIC_TECH_DOCS_URL=https://docs.oando.co.in
#   3) Docs build host (Vite): NEXT_ADMIN_SUPABASE_URL + NEXT_ADMIN_SUPABASE_ANON_KEY only
#      (never service role / R2 secrets on the static docs host)

# --- Dev / E2E ---
DEV_AUTH_BYPASS=1
E2E_SUPABASE_ADMIN_EMAIL=
E2E_SUPABASE_ADMIN_PASSWORD=
E2E_SUPABASE_USER_EMAIL=
E2E_SUPABASE_USER_PASSWORD=

# --- Admin / ops portals ---
ADMIN_TOKEN=
CUSTOMER_QUERIES_ADMIN_TOKEN=
OPS_PORTAL_USER=
OPS_PORTAL_PASSWORD=

# --- Feature flags (explicit workstation profile) ---
ACTIVE_THEME_ID=premium-light
SITE_MAINTENANCE_MODE=readonly
NEXT_PUBLIC_CRM_DEMO_MODE=1
SVG_RELEASE_AUTHORITY=db
PNG_DISK_MIRROR=0

# --- Planner persistence note ---
# DEV_AUTH_BYPASS=1 → disk projects in dev unless you use Supabase planner path.
# SVG_RELEASE_AUTHORITY=db → released SVG authority is DB even in local dev.
