{
  "name": "oando-tech-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ../scripts/general/guard-workspace-install.mjs",
    "dev": "vite",
    "generate": "node scripts/generate-all.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/generate-all.mjs && vite build && node scripts/publish-all.mjs --surfaces=site",
    "gate": "node scripts/gate.mjs",
    "preview": "vite preview",
    "typecheck": "node scripts/generate-all.mjs && tsc --noEmit",
    "test": "node ../node_modules/vitest/vitest.mjs run",
    "sync-css": "node scripts/sync-css.mjs",
    "test:coverage": "node ../node_modules/vitest/vitest.mjs run --coverage",
    "coverage": "node ../node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "2.1.1",
    "framer-motion": "^12.43.0",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "mermaid": "^11.17.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "postcss": "8.5.28",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
